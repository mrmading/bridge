{
  "name": "bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "preview_urls": false,
  // dist/ is assembled by deploy/build.sh: public/ at the root, mobile/build/web at /m/
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "vars": {
    // the sprite; override per run with --var BACKEND_URL:<url> (deploy.sh does for local tests)
    "BACKEND_URL": "https://bridge-x2x6.sprites.app"
  },
  // off: GET streams carry ?access_token=, and persisted invocation logs would keep those URLs. `wrangler tail` still works live.
  "observability": { "enabled": false }
}
